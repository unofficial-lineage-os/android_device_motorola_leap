// Mount points for the stock firmware partitions
mkdir {
    name: "vendor_fsg_mountpoint_leap",
    dir: "fsg",
    vendor: true,
}

mkdir {
    name: "vendor_super_modem_mountpoint_leap",
    dir: "super_modem",
    vendor: true,
}

mkdir {
    name: "vendor_super_fsg_mountpoint_leap",
    dir: "super_fsg",
    vendor: true,
}

