// first-stage mount needs this inside vendor_ramdisk; the running system needs the vendor copy
prebuilt_etc {
    name: "fstab.default",
    src: "fstab.default",
    vendor: true,
    vendor_ramdisk_available: true,
}

// Recovery: USB gadget and the /dev/block/bootdevice symlink
prebuilt_etc {
    name: "init.qcom.recovery.rc",
    src: "init.qcom.recovery.rc",
    sub_dir: "init",
    recovery: true,
}

// Stock vendor init scripts (vendor/etc/init/hw). init.rc imports init.${ro.hardware}.rc from there.

prebuilt_etc {
    name: "init.mmi.charge_only.rc",
    src: "hw/init.mmi.charge_only.rc",
    sub_dir: "init/hw",
    vendor: true,
}

