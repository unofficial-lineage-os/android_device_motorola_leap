# BRING-UP ONLY (findings.md D15s) — early adb on every normal boot.
# Moto's init.mmi.usb.rc blanks persist.sys.usb.config at load_bpf_programs, so AOSP's
# init.usb.rc `on boot && property:persist.sys.usb.config=*` sets sys.usb.config to " " and
# adbd never starts until the framework's UsbDeviceManager runs (which never happened here).
# Force the AOSP configfs early-adb path instead, exactly as init.qcom.recovery.rc does for
# recovery (verified on device 2026-09-20: that path enumerates 22b8:2e81 and gives adb).
# Remove once the framework brings USB up on its own.

on init
    setprop sys.usb.configfs 1

on boot
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1
    setprop persist.vendor.usb.config adb
    setprop vendor.usb.config adb
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb

# D15zz: USB HAL restored (it services the ADSP type-C/PD attach events; with it stopped the phone
# reset on every USB attach once the firmware partitions mounted). adb is requested through the
# persist props Moto's rc copies into persist.sys.usb.config; no more =none guard.

# D15t: USB-independent boot log to the logks partition (see bringup_log.sh). Root, permissive.
service bringup_log /vendor/bin/bringup_log.sh
    class core
    user root
    group root system
    seclabel u:r:su:s0
    disabled
    oneshot

# D40: no longer started — adb works in normal boot and the service ran as u:r:su:s0 (194 denials/boot,
# and a root domain is not acceptable for enforcing). Start it by hand for a no-adb boot investigation:
#   adb shell setprop ctl.start bringup_log   (or uncomment below)
#on early-init
#    start bringup_log

# D15y (bring-up only): these A15 blobs die with CFI violations (__cfi_slowpath) every few seconds and
# the kernel panics right after the camera provider's crash-driven driver teardown. Keep them down
# until the CFI/blob issue is addressed; nothing boot-critical depends on them.
# D20: camera-provider hold LIFTED (A16 kernel + vendor-private libs; re-test).
on property:init.svc.poweropt-service=running
    stop poweropt-service
on property:init.svc.poweropt-service=restarting
    stop poweropt-service
on property:init.svc.vendor.moto_lpsensing=running
    stop vendor.moto_lpsensing
on property:init.svc.vendor.moto_lpsensing=restarting
    stop vendor.moto_lpsensing
