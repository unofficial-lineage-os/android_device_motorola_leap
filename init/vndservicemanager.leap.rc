# leap D24: stock vndservicemanager (see proprietary-files.txt); replaces the source module's rc.
service vndservicemanager /vendor/bin/hw/vndservicemanager-stock /dev/vndbinder
    class core
    user system
    group system readproc
    file /dev/kmsg w
    task_profiles ServiceCapacityLow
    onrestart class_restart main
    onrestart class_restart hal
    onrestart class_restart early_hal
    shutdown critical
