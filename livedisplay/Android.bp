//
// leap (Motorola Razr Ultra 2025) LiveDisplay HAL, bridged to Motorola's com.motorola.hardware.display.panel
// IDisplayPanel (AIDL V2) like stock's framework does:
//   IAntiFlicker ("DC dimming")            -> IDisplayPanel::setDcMode (txn 4)
//   ISunlightEnhancement ("Outdoor mode")  -> IDisplayPanel::setMode HIGH_BRIGHT/NORMAL (txn 5)
// leap has no writable panel-feature sysfs nodes; stock's displaypanel.default.so drives them through
// /dev/dri/card0, so this service drives the stock HAL instead.

cc_binary {
    name: "vendor.lineage.livedisplay-service.leap",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.livedisplay-service.leap.rc"],
    vintf_fragments: ["vendor.lineage.livedisplay-service.leap.xml"],
    srcs: [
        "AntiFlicker.cpp",
        "MotoPanel.cpp",
        "SunlightEnhancement.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
}
