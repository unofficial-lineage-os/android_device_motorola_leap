<!--
    Input:
        device/qcom/sun/manifest_sun.xml
        device/moto/leap/manifest_leap.xml
        motorola/hardware/interfaces/ifaa/service_qcom/manifest.xml
-->
<!-- NOTE: the stock file's sepolicy-version block was removed here. Android 16 forces
     BOARD_SEPOLICY_VERS = PLATFORM_SEPOLICY_VERSION (.KATI_READONLY, build/make/core/config.mk:881),
     and we build the vendor partition sepolicy from source, so it is at platform level.
     target-level is kept at the level the A15-era blob HALs actually target. -->
<manifest version="8.0" type="device" target-level="202404">
    <hal format="aidl">
        <name>android.hardware.biometrics.fingerprint</name>
        <version>3</version>
        <fqname>IFingerprint/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <fqname>IGatekeeper/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.nfc</name>
        <fqname>INfc/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.secure_element</name>
        <fqname>ISecureElement/eSE1</fqname>
    </hal>
    <hal format="aidl">
        <name>com.motorola.hardware.display.touch</name>
        <version>3</version>
        <fqname>IMotTouch/default</fqname>
    </hal>
    <hal format="aidl">
        <name>com.motorola.hardware.ifaa</name>
        <fqname>IIFAADevice/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.nxp.nxpnfc_aidl</name>
        <fqname>INxpNfc/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.qti.hardware.spu</name>
        <version>2</version>
        <fqname>ISPUManager/default</fqname>
    </hal>
</manifest>
