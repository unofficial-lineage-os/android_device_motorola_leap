<?xml version="1.0" encoding="utf-8"?>
<!-- leap D22: LineageOS Settings switches -->
<resources>
    <!-- Show Smooth Display / peak refresh rate options (both panels do 24–165 Hz) -->
    <bool name="config_show_smooth_display">true</bool>
    <!-- Peak refresh rate list (24/60/90/120/165); min list appears automatically -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
    <!-- Battery cycle count is exposed by the Moto health HAL -->
    <bool name="config_show_battery_cycle_count" translatable="false">true</bool>
</resources>
