allow { domain -coredomain -hal_configstore } bugreport_data_file:file { write getattr };
allow shell bugreport_data_file:dir { ioctl read getattr lock open watch watch_reads search };
allow shell bugreport_data_file:file { ioctl read getattr lock map open watch watch_reads };
allow vdc bugreport_data_file:file { getattr };
