allow hal_wifi_supplicant_server cutback_data_file:dir { ioctl read getattr lock open watch watch_reads search };
allow rild cutback_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow rild cutback_data_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow rild cutback_data_file:sock_file { write unlink };
