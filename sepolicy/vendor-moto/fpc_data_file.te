allow hal_fingerprint_default fpc_data_file:dir { write lock open add_name remove_name search };
allow hal_fingerprint_default fpc_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow tee fpc_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow tee fpc_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
