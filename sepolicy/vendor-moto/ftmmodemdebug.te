allow init ftmmodemdebug:process { transition };
allow ftmmodemdebug ftmmodemdebug_exec:file { read getattr map execute open entrypoint };
dontaudit init ftmmodemdebug:process { noatsecure };
allow init ftmmodemdebug:process { siginh rlimitinh };
type_transition init ftmmodemdebug_exec:process ftmmodemdebug;
allow ftmmodemdebug vendor_diag_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow ftmmodemdebug vendor_radio_prop:file { read getattr map open };
allow ftmmodemdebug vendor_ssr_prop:file { read getattr map open };
