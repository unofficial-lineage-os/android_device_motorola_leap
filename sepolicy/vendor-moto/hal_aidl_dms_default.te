allow init hal_aidl_dms_default:process { transition };
allow hal_aidl_dms_default hal_aidl_dms_default_exec:file { read getattr map execute open entrypoint };
dontaudit init hal_aidl_dms_default:process { noatsecure };
allow init hal_aidl_dms_default:process { siginh rlimitinh };
type_transition init hal_aidl_dms_default_exec:process hal_aidl_dms_default;
allow hal_aidl_dms_default vendor_dolby_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_aidl_dms_default vendor_dolby_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_aidl_dms_default vendor_mot_dolby_prop:file { read getattr map open };
