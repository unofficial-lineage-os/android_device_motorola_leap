allow init hal_maya_default:process { transition };
allow hal_maya_default hal_maya_default_exec:file { read getattr map execute open entrypoint };
dontaudit init hal_maya_default:process { noatsecure };
allow init hal_maya_default:process { siginh rlimitinh };
type_transition init hal_maya_default_exec:process hal_maya_default;
