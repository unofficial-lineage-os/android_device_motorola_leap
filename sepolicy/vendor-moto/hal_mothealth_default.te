allow dumpstate hal_mothealth_default:binder { call transfer };
allow hal_mothealth_default dumpstate:binder { transfer };
allow dumpstate hal_mothealth_default:fd { use };
allow init hal_mothealth_default:process { transition };
allow hal_mothealth_default hal_mothealth_default_exec:file { read getattr map execute open entrypoint };
dontaudit init hal_mothealth_default:process { noatsecure };
allow init hal_mothealth_default:process { siginh rlimitinh };
type_transition init hal_mothealth_default_exec:process hal_mothealth_default;
allow hal_mothealth_default dumpstate:fd { use };
allow hal_mothealth_default dumpstate:fifo_file { write };
