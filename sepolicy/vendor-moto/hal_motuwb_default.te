allow init hal_motuwb_default:process { transition };
allow hal_motuwb_default hal_motuwb_default_exec:file { read getattr map execute open entrypoint };
dontaudit init hal_motuwb_default:process { noatsecure };
allow init hal_motuwb_default:process { siginh rlimitinh };
type_transition init hal_motuwb_default_exec:process hal_motuwb_default;
