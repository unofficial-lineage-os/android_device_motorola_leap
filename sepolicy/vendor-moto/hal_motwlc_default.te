allow dumpstate hal_motwlc_default:binder { call transfer };
allow hal_motwlc_default dumpstate:binder { transfer };
allow dumpstate hal_motwlc_default:fd { use };
allow init hal_motwlc_default:process { transition };
allow hal_motwlc_default hal_motwlc_default_exec:file { read getattr map execute open entrypoint };
dontaudit init hal_motwlc_default:process { noatsecure };
allow init hal_motwlc_default:process { siginh rlimitinh };
type_transition init hal_motwlc_default_exec:process hal_motwlc_default;
allow hal_motwlc_default dumpstate:fd { use };
allow hal_motwlc_default dumpstate:fifo_file { write };
allow hal_motwlc_default sysfs:file { read };
