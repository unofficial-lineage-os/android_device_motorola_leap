allow init hal_sensorext_default:process { siginh rlimitinh };
type_transition init hal_sensorext_default_exec:process hal_sensorext_default;
allow hal_sensorext_default system_server:binder { call transfer };
allow system_server hal_sensorext_default:binder { transfer };
allow hal_sensorext_default system_server:fd { use };
