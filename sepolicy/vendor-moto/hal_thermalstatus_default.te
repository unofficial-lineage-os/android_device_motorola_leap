allow init hal_thermalstatus_default:process { transition };
allow hal_thermalstatus_default hal_thermalstatus_default_exec:file { read getattr map execute open entrypoint };
dontaudit init hal_thermalstatus_default:process { noatsecure };
allow init hal_thermalstatus_default:process { siginh rlimitinh };
type_transition init hal_thermalstatus_default_exec:process hal_thermalstatus_default;
allow hal_thermalstatus_default vendor_thermal_socket:sock_file { write };
allow hal_thermalstatus_default vendor_thermal-engine:unix_stream_socket { connectto };
allow hal_thermalstatus_default sysfs_devices_system_cpu:file { ioctl read write getattr lock append map open watch watch_reads };
allow system_server hal_thermalstatus_default:binder { call transfer };
allow hal_thermalstatus_default system_server:binder { transfer };
allow system_server hal_thermalstatus_default:fd { use };
