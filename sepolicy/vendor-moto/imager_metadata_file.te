allow hal_camera_default imager_metadata_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_camera_default imager_metadata_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_camera_default imager_metadata_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
