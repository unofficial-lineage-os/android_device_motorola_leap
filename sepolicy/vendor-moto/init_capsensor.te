allow init init_capsensor:process { transition };
allow init_capsensor init_capsensor_exec:file { read getattr map execute open entrypoint };
dontaudit init init_capsensor:process { noatsecure };
allow init init_capsensor:process { siginh rlimitinh };
type_transition init init_capsensor_exec:process init_capsensor;
allow init_capsensor kmsg_device:chr_file { write open };
allow init_capsensor sysfs_capsense:dir { search };
allow init_capsensor sysfs_capsense:file { getattr setattr };
allow init_capsensor sysfs_capsense:lnk_file { read };
allow init_capsensor vendor_toolbox_exec:file { execute_no_trans };
allow init_capsensor self:capability { chown };
