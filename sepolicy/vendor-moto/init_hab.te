allow init init_hab:process { transition };
allow init_hab init_hab_exec:file { read getattr map execute open entrypoint };
dontaudit init init_hab:process { noatsecure };
allow init init_hab:process { siginh rlimitinh };
type_transition init init_hab_exec:process init_hab;
allow init_hab property_socket:sock_file { write };
allow init_hab init:unix_stream_socket { connectto };
allow init_hab vendor_mot_hab_prop:property_service { set };
allow init_hab vendor_mot_hab_prop:file { read getattr map open };
allow init_hab powerctl_prop:property_service { set };
allow init_hab powerctl_prop:file { read getattr map open };
allow init_hab rootfs:dir { ioctl read getattr lock open watch watch_reads search };
allow init_hab rootfs:file { ioctl read getattr lock map open watch watch_reads };
allow init_hab rootfs:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow init_hab oemfs:dir { ioctl read getattr lock open watch watch_reads search };
allow init_hab oemfs:file { ioctl read getattr lock map open watch watch_reads };
allow init_hab oemfs:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow init_hab vendor_file:dir { ioctl read getattr lock open watch watch_reads search };
allow init_hab vendor_file:file { ioctl read getattr lock map open watch watch_reads };
allow init_hab vendor_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow init_hab vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow init_hab vendor_shell_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow init_hab bl_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow init_hab block_device:dir { search };
allow init_hab vendor_file:file { execute_no_trans };
allow init_hab kmsg_device:chr_file { write lock append map open };
