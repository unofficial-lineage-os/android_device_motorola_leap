allow init init_usb:process { transition };
allow init_usb init_usb_exec:file { read getattr map execute open entrypoint };
dontaudit init init_usb:process { noatsecure };
allow init init_usb:process { siginh rlimitinh };
type_transition init init_usb_exec:process init_usb;
allow init_usb vendor_shell_exec:file { ioctl read getattr lock map open watch watch_reads };
allow init_usb property_socket:sock_file { write };
allow init_usb init:unix_stream_socket { connectto };
allow init_usb vendor_mot_factory_prop:property_service { set };
allow init_usb vendor_mot_factory_prop:file { read getattr map open };
allow init_usb vendor_mot_init_prop:property_service { set };
allow init_usb vendor_mot_init_prop:file { read getattr map open };
allow init_usb vendor_mot_boot_prop:file { read getattr map open };
allow init_usb sysfs:file { write setattr lock append map open };
allow init_usb sysfs_android_usb:file { ioctl read write getattr lock append map open watch watch_reads };
allow init_usb sysfs_android_usb:dir { search };
allow init_usb self:capability { chown fowner };
allow init_usb vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
dontaudit init_usb self:capability { fsetid };
allow init_usb configfs:dir { search };
allow init_usb configfs:file { write lock append map open };
allow init_usb vendor_mot_tcmd_prop:file { read getattr map open };
allow init_usb kmsg_device:chr_file { write lock append map open };
allow init_usb vendor_mot_tcmd_ctrl_adb_prop:file { read getattr map open };
allow init_usb vendor_radio_prop:file { read getattr map open };
allow init_usb vendor_usb_prop:property_service { set };
allow init_usb vendor_usb_prop:file { read getattr map open };
allow init_usb vendor_sysfs_usb_device:file { ioctl read getattr lock map open watch watch_reads };
