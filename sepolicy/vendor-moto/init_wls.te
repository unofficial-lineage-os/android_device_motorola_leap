allow init init_wls:process { transition };
allow init_wls init_wls_exec:file { read getattr map execute open entrypoint };
dontaudit init init_wls:process { noatsecure };
allow init init_wls:process { siginh rlimitinh };
type_transition init init_wls_exec:process init_wls;
allow init_wls vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
allow init_wls kmsg_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow init_wls vendor_sysfs_battery_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow init_wls sysfs_wls_dev:dir { ioctl read getattr lock open watch watch_reads search };
allow init_wls sysfs_wls_dev:file { ioctl read write getattr lock append map open watch watch_reads };
allow init_wls firmware_file:dir { ioctl read getattr lock open watch watch_reads search };
allow init_wls firmware_file:file { ioctl read getattr lock map open watch watch_reads };
allow init_wls firmware_file:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow init_wls vendor_sysfs_battery_supply:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow init_wls vendor_sysfs_usb_supply:dir { ioctl read getattr lock open watch watch_reads search };
allow init_wls sysfs_wls_dev:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow init_wls self:capability { chown fowner fsetid };
