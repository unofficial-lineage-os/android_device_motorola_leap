allowxperm e2fs logks_block_device:blk_file ioctl { 0x125e 0x1277 0x127b-0x127c };
allowxperm e2fs logks_block_device:blk_file ioctl { 0xf50d };
allow e2fs logks_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow fsck logks_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow init logks_block_device:lnk_file { relabelto };
