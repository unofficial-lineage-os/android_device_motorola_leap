allow init mbm_spy:process { transition };
allow mbm_spy mbm_spy_exec:file { read getattr map execute open entrypoint };
dontaudit init mbm_spy:process { noatsecure };
allow init mbm_spy:process { siginh rlimitinh };
type_transition init mbm_spy_exec:process mbm_spy;
allow mbm_spy block_device:dir { search };
allow mbm_spy utags_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow mbm_spy rtc_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow mbm_spy proc:dir { ioctl read getattr lock open watch watch_reads search };
allow mbm_spy proc:file { ioctl read getattr lock map open watch watch_reads };
allow mbm_spy proc:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow mbm_spy mot_core_property_type:file { read getattr map open };
allow mbm_spy proc_version:file { ioctl read getattr lock map open watch watch_reads };
allow mbm_spy proc_bootinfo:file { ioctl read getattr lock map open watch watch_reads };
allow mbm_spy vendor_radio_prop:file { read getattr map open };
allow mbm_spy vendor_mot_spu_prop:file { read getattr map open };
