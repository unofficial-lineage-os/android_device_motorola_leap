allow shell mot_mdlog_data_file:dir { ioctl read getattr lock open watch watch_reads search };
allow shell mot_mdlog_data_file:file { ioctl read getattr lock map open watch watch_reads };
allow system_app mot_mdlog_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow system_app mot_mdlog_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
