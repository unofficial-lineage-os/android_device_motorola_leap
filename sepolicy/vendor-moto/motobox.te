allow init motobox:process { transition };
allow motobox motobox_exec:file { read getattr map execute open entrypoint };
dontaudit init motobox:process { noatsecure };
allow init motobox:process { siginh rlimitinh };
type_transition init motobox_exec:process motobox;
allow motobox tmpfs:chr_file { ioctl read write };
allow motobox devpts:chr_file { ioctl read write getattr };
allow motobox block_device:dir { search };
allow motobox swap_block_device:blk_file { ioctl read write getattr lock append map open watch watch_reads };
allow motobox vendor_toolbox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
