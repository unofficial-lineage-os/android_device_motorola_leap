allow vendor_misc_writer motobox_exec:file { read getattr map execute open entrypoint };
allow init motobox_exec:file { read getattr map execute open };
allow { domain -coredomain -halserverdomain -vendor_init -mediacodec -vendor_halserverdomain } motobox_exec:file { ioctl read getattr lock map execute open watch watch_reads execute_no_trans };
