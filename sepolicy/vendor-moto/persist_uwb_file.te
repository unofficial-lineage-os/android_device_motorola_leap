allow hal_motuwb_server persist_uwb_file:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_motuwb_server persist_uwb_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_uwb_default persist_uwb_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_uwb_default persist_uwb_file:file { ioctl read write getattr lock append map open watch watch_reads };
