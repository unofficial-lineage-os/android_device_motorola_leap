allow hal_fingerprint_default sysfs_fpc:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_fingerprint_default sysfs_fpc:file { ioctl read getattr lock map open watch watch_reads };
allow hal_fingerprint_default sysfs_fpc:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_fingerprint_default sysfs_fpc:file { ioctl read write getattr lock append map open watch watch_reads };
allow ueventd sysfs_fpc:file { write open };
