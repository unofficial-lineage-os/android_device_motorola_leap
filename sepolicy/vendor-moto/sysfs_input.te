allow hal_audio_server sysfs_input:dir { search };
allow hal_audio_server sysfs_input:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_audio_server sysfs_input:file { ioctl read getattr lock map open watch watch_reads };
allow hal_audio_server sysfs_input:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow hal_sensors sysfs_input:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_sensors sysfs_input:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_sensors sysfs_input:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow ueventd sysfs_input:file { write lock append map open };
