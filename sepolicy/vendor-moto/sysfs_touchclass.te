allow hal_mottouch_server sysfs_touchclass:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_mottouch_server sysfs_touchclass:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_sensors_default sysfs_touchclass:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_sensors_default sysfs_touchclass:file { ioctl read getattr lock map open watch watch_reads };
allow hal_sensors_default sysfs_touchclass:lnk_file { ioctl read getattr lock map open watch watch_reads };
