allow hal_motpowershare_server sysfs_wls_dev:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_motpowershare_server sysfs_wls_dev:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_motwlc_server sysfs_wls_dev:dir { search };
allow hal_motwlc_server sysfs_wls_dev:file { ioctl read write getattr lock append map open watch watch_reads };
