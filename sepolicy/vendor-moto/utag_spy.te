allow init utag_spy:process { transition };
allow utag_spy utag_spy_exec:file { read getattr map execute open entrypoint };
dontaudit init utag_spy:process { noatsecure };
allow init utag_spy:process { siginh rlimitinh };
type_transition init utag_spy_exec:process utag_spy;
allow utag_spy proc_hwconf:dir { search };
allow utag_spy proc_hwconf:file { ioctl read write getattr lock append map open watch watch_reads };
