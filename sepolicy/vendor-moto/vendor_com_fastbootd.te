allow init vendor_com_fastbootd:process { transition };
allow vendor_com_fastbootd vendor_com_fastbootd_exec:file { read getattr map execute open entrypoint };
dontaudit init vendor_com_fastbootd:process { noatsecure };
allow init vendor_com_fastbootd:process { siginh rlimitinh };
type_transition init vendor_com_fastbootd_exec:process vendor_com_fastbootd;
allow vendor_com_fastbootd functionfs:dir { ioctl read getattr lock open watch watch_reads search };
allow vendor_com_fastbootd functionfs:file { ioctl read write getattr lock append map open watch watch_reads };
allowxperm vendor_com_fastbootd functionfs:file ioctl { 0x6782 };
allow vendor_com_fastbootd property_socket:sock_file { write };
allow vendor_com_fastbootd init:unix_stream_socket { connectto };
allow vendor_com_fastbootd powerctl_prop:property_service { set };
allow vendor_com_fastbootd powerctl_prop:file { read getattr map open };
allow vendor_com_fastbootd vendor_usb_prop:property_service { set };
allow vendor_com_fastbootd vendor_usb_prop:file { read getattr map open };
