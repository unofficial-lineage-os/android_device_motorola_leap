# leap — sysfs nodes that stock leaves as generic `sysfs` (D50, from enforcing denials on 2026-09-23).
# Stock labels /sys/class/fingerprint via file_contexts (only effective after restorecon); the driver's
# real node is a platform device, so label it with genfscon (longest-prefix wins; the wakeup subdir below
# is more specific and stays sysfs_wakeup).
genfscon sysfs /devices/platform/soc/soc:fpc_fpc1020 u:object_r:sysfs_fpc:s0

# Wakeup sources hanging off device nodes. Core policy only labels /class/wakeup and /devices/virtual/wakeup;
# system_suspend reads every source's stats (wakeup_count, active_time_ms, …) for batterystats.
genfscon sysfs /devices/platform/soc/soc:fpc_fpc1020/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/soc:mmi,charger/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/misc/fastrpc-adsp-secure/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/misc/fastrpc-cdsp/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/misc/fastrpc-cdsp-secure/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/894000.spi/spi_master/spi1/spi1.0/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/8c0000.qcom,qupv3_2_geni_se/89c000.spi/spi_master/spi2/spi2.0/wakeup u:object_r:sysfs_wakeup:s0
